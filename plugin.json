{
  "name": "zf_schedule",
  "version": "1.0.0",
  "description": "正方教务系统课表查询插件，支持自动登录、课表变化检测、表格视图生成",
  "author": "ZF Schedule Team",
  "main": "hermes_plugin.py",
  "dependencies": {
    "playwright": ">=1.40.0"
  },
  "commands": {
    "setup": {
      "description": "配置账号密码和教务系统URL",
      "parameters": {
        "username": {
          "type": "string",
          "required": true,
          "description": "学号"
        },
        "password": {
          "type": "string",
          "required": true,
          "description": "密码"
        },
        "base_url": {
          "type": "string",
          "required": true,
          "description": "教务系统URL，例如 https://jwxt.gxnzd.com.cn/"
        },
        "year": {
          "type": "string",
          "required": false,
          "default": "2026",
          "description": "学年起始年"
        },
        "term": {
          "type": "string",
          "required": false,
          "default": "3",
          "enum": ["3", "12"],
          "description": "学期：3=第一学期，12=第二学期"
        },
        "start_date": {
          "type": "string",
          "required": false,
          "default": "2026-09-01",
          "description": "学期开始日期，格式 YYYY-MM-DD"
        }
      },
      "examples": [
        "setup --username 20230001 --password mypass123 --base-url https://jwxt.gxnzd.com.cn/",
        "setup --username 20230001 --password mypass123 --base-url https://jwxt.gxnzd.com.cn/ --year 2026 --term 3 --start-date 2026-09-01"
      ]
    },
    "get": {
      "description": "获取课表并生成表格视图",
      "parameters": {
        "force_login": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "是否强制重新登录"
        },
        "format": {
          "type": "string",
          "required": false,
          "default": "table",
          "enum": ["table", "simple", "json"],
          "description": "输出格式：table=表格视图，simple=简化列表，json=原始JSON"
        }
      },
      "examples": [
        "get",
        "get --format table",
        "get --force-login",
        "get --format simple"
      ]
    },
    "check": {
      "description": "检查课表是否有变化",
      "parameters": {},
      "examples": [
        "check"
      ]
    }
  },
  "install": {
    "steps": [
      "uv add playwright",
      "uv run playwright install chromium"
    ]
  },
  "repository": "https://github.com/yourusername/ZF_Class_Schedule",
  "license": "MIT"
}
